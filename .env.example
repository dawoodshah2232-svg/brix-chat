# Brix Chat — frontend environment variables
#
# Copy to .env. The dashboard talks to the Laravel API in api/ (MySQL).
# On localhost the app uses http://127.0.0.1:8099/api when this is unset.
# Leave it unset on a non-local host to run on browser storage only (demo mode).

# Laravel API base URL, e.g. https://example.com/api
VITE_API_URL=http://127.0.0.1:8099/api
