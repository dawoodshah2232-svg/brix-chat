# Apache (cPanel) routing for the Brix Chat dashboard.
# Works at the site root or in a sub-folder such as bridgingfx.com/brixchat/.
# Vite copies this file into the build; the dev server ignores it.

Options -MultiViews -Indexes
DirectoryIndex index.html

RewriteEngine On

# Force HTTPS (cPanel/Apache). Preserves the sub-folder path and query string.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# API entry (brixchat/backend -> Laravel): Laravel's own .htaccess handles it.
RewriteRule ^backend(/|$) - [L]

# Real files and folders are served as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Every other path is a dashboard route: load the app, which shows the page.
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # Always re-check the page shell so a new deploy is picked up immediately...
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # ...while build assets (content-hashed file names) can be cached for good.
  <If "%{REQUEST_URI} =~ m#/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
