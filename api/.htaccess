# Brix Chat PHP API — clean URLs.
# /api/<resource>  ->  index.php?route=<resource>

RewriteEngine On

# Never serve these as static files
<Files "config.php">
    Require all denied
</Files>
<Files "config.sample.php">
    Require all denied
</Files>

# Real files (cron scripts, assets) pass through untouched
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else goes to the single-entry router
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
